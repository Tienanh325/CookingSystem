{
  "expo": {
    "name": "Cookmate",
    "slug": "cookmate-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#BD420B",
          "defaultChannel": "default"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.cookmate.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.cookmate.mobile",
      "permissions": ["POST_NOTIFICATIONS"]
    },
    "scheme": "cookmate"
  }
}
