PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cookmate
DB_USER=root
DB_PASSWORD=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=
ADMIN_PASSWORD=
NODE_ENV=development
# Public HTTPS backend origin, WITHOUT /api, for OAuth callbacks
AUTH_PUBLIC_URL=
AUTH_REDIRECT_URIS=cookmate://auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Services ID and generated Apple client-secret JWT (rotate before expiry)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Email verification and password reset
APP_PUBLIC_URL=cookmate://
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Cookmate <no-reply@example.com>
EMAIL_VERIFY_EXPIRES_MINUTES=1440
PASSWORD_RESET_EXPIRES_MINUTES=30

# Optional when the Expo project enables enhanced push security
EXPO_ACCESS_TOKEN=

# VNPAY Sandbox. Đăng ký merchant tại https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# HTTPS public endpoint của backend, VNPAY sẽ chuyển trình duyệt về đây
VNPAY_RETURN_URL=https://api.example.com/api/thanh-toan/vnpay/return
# Deep link mở lại ứng dụng sau Return URL
VNPAY_APP_RETURN_URL=cookmate://thanh-toan
