PORT=8080
HOST=0.0.0.0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cookmate
DB_USER=root
DB_PASSWORD=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=
ADMIN_PASSWORD=
NODE_ENV=development

# Password reset email
APP_PUBLIC_URL=cookmate://
# Gmail: bật Xác minh 2 bước và dùng App Password 16 ký tự, không dùng mật khẩu Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Có thể bỏ trống; mặc định dùng "Cookmate <SMTP_USER>".
EMAIL_FROM=
# Chỉ bật khi muốn in liên kết ra terminal thay vì gửi thư thật.
EMAIL_DEV_PREVIEW=false
PASSWORD_RESET_EXPIRES_MINUTES=30

# Optional when the Expo project enables enhanced push security
EXPO_ACCESS_TOKEN=

# VietQR nhận tiền qua Techcombank
VIETQR_BANK_ID=TCB
VIETQR_BANK_NAME=Techcombank
VIETQR_ACCOUNT_NO=9330302005
VIETQR_ACCOUNT_NAME=DƯƠNG TIẾN ANH
VIETQR_TEMPLATE=print
